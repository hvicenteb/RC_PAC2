<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#"
     xml:base="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:IntelligentTourismOntology="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology">
        <rdfs:comment>Ontology for Intelligent Tourism (ITO)</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#sameAs -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#sameAs"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#availableAtCity -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#availableAtCity">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasTourismResource"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TourismResource"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City"/>
        <rdfs:comment>Relates a tourism resource to the city where it is located</rdfs:comment>
        <rdfs:label>availableAtCity</rdfs:label>
        <rdfs:seeAlso>schema:availableAtOrFrom
https://schema.org/availableAtOrFrom</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#cityLocation -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#cityLocation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isLocationOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Point"/>
        <rdfs:comment>The relation between a City and the Point that has the coordinates</rdfs:comment>
        <rdfs:label>cityLocation</rdfs:label>
        <rdfs:sameAs>geo:location
&lt;http://www.w3.org/2003/01/geo/wgs84_pos#location&gt;</rdfs:sameAs>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasTourismResource -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasTourismResource">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TourismResource"/>
        <rdfs:comment>Relates a city with a tourist resource available in it.</rdfs:comment>
        <rdfs:label>hasTourismResource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isLocationOf -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isLocationOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Point"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City"/>
        <rdfs:comment>The relation between the Point and the City that is located at the point coordinates</rdfs:comment>
        <rdfs:label>isLocationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasAveragePrice -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasAveragePrice">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasPrice"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Restaurant"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Transport"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasNightPrice"/>
        <rdfs:comment>The average price of a specific Tourism Resource</rdfs:comment>
        <rdfs:label>hasAveragePrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date may be used to express temporal information according to ISO 8601-1</rdfs:comment>
        <rdfs:label>hasDate</rdfs:label>
        <rdfs:seeAlso>dcterms:date
&lt;http://purl.org/dc/terms/date&gt;</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasIdentifier -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TourismResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>An unambiguous reference to the resource within a given context.</rdfs:comment>
        <rdfs:label>hasIdentifier</rdfs:label>
        <rdfs:seeAlso>dcterms:identifier
&lt;http://purl.org/dc/terms/identifier&gt;</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasLatitude -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasLatitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Point"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-90.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">90.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>Latitude coordinate of a point</rdfs:comment>
        <rdfs:label>hasLatitude</rdfs:label>
        <rdfs:sameAs>geo:lat
&lt;http://www.w3.org/2003/01/geo/wgs84_pos#lat&gt;</rdfs:sameAs>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasLongitude -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasLongitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Point"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-180.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">180.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>Longitude coordinate of a point</rdfs:comment>
        <rdfs:label>hasLongitude</rdfs:label>
        <rdfs:sameAs>geo:long
&lt;http://www.w3.org/2003/01/geo/wgs84_pos#long&gt;</rdfs:sameAs>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TourismResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A name for some thing</rdfs:comment>
        <rdfs:label>hasName</rdfs:label>
        <rdfs:seeAlso>foaf:name
&lt;http://xmlns.com/foaf/0.1/name&gt;</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasNightPrice -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasNightPrice">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasPrice"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The night price of a hotel</rdfs:comment>
        <rdfs:label>hasNightPrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasPrice -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasPrice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Restaurant"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Transport"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The offer price of a product, in this case of a specific Tourism Resource</rdfs:comment>
        <rdfs:label>hasPrice</rdfs:label>
        <rdfs:seeAlso>schema:price
https://schema.org/price</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasProvider -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasProvider">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The name of the service provider, service operator, or service performer</rdfs:comment>
        <rdfs:label>hasProvider</rdfs:label>
        <rdfs:seeAlso>schema:provider
&lt;https://schema.org/provider&gt;</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasRating -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasRating">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Restaurant"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TouristAttraction"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>The average rating given by users</rdfs:comment>
        <rdfs:label>hasRating</rdfs:label>
        <rdfs:seeAlso>dbpedia-owl:rating
&lt;http://dbpedia.org/ontology/rating&gt;</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasStarRating -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#hasStarRating">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>The star rating of the Hotel</rdfs:comment>
        <rdfs:label>hasStarRating</rdfs:label>
        <rdfs:seeAlso>dbpedia-owl:starRating
&lt;http://dbpedia.org/ontology/starRating&gt;</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isHighlyRatedByUsers -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isHighlyRatedByUsers">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TourismResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether a Tourist Resource has been rated above a certain value by users.</rdfs:comment>
        <rdfs:label>isHighlyRatedByUsers</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isTopHotel -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#isTopHotel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether a Hotel has been rated above a certain value by users and has more than a certain number of stars</rdfs:comment>
        <rdfs:label>isTopHotel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#AndalusianRestaurant -->


    <owl:Class rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#AndalusianRestaurant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Restaurant"/>
        <rdfs:comment>It is a type of restaurant serving Andalusian dishes</rdfs:comment>
        <rdfs:label>AndalusianRestaurant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BeachAttraction -->


    <owl:Class rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BeachAttraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#TouristAttraction"/>
        <rdfs:comment>It is a type of natural attraction, usually related to coastal areas</rdfs:comment>
        <rdfs:label>BeachAttraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BeachHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BeachHotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
        <rdfs:comment>It is a type of hotel that is located near the beach</rdfs:comment>
        <rdfs:label>BeachHotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BusTransport -->


    <owl:Class rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BusTransport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Transport"/>
        <rdfs:comment>It is a means of public transport that operates on established routes</rdfs:comment>
        <rdfs:label>BusTransport</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BusinessHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#BusinessHotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#Hotel"/>
        <rdfs:comment>It is a type of hotel designed for business professionals</rdfs:comment>
        <rdfs:label>BusinessHotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City -->


    <owl:Class rdf:about="http://www.semanticweb.org/hecto/ontologies/2025/3/IntelligentTourismOntology#City">
        <rdfs:comment>A city is a geographical location that has associated geographical coordinates</rdfs:comment>
        <rdfs:label>City</rdfs:label>
