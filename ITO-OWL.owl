        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal>Defines if a hotel is a Top Hotel</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:label"/>
            <Literal>isTopHotelRule</Literal>
        </Annotation>
        <Body>
            <ClassAtom>
                <Class IRI="#Hotel"/>
                <Variable IRI="/h"/>
            </ClassAtom>
            <DataPropertyAtom>
                <DataProperty IRI="#isHighlyRatedByUsers"/>
                <Variable IRI="/h"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
            </DataPropertyAtom>
            <BuiltInAtom abbreviatedIRI="swrlb:equal">
                <Variable IRI="/s"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">5</Literal>
            </BuiltInAtom>
            <DataPropertyAtom>
                <DataProperty IRI="#hasStarRating"/>
                <Variable IRI="/h"/>
                <Variable IRI="/s"/>
            </DataPropertyAtom>
        </Body>
        <Head>
            <DataPropertyAtom>
                <DataProperty IRI="#isTopHotel"/>
                <Variable IRI="/h"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
            </DataPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="swrla:isRuleEnabled"/>
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal>Defines if a TourismResource is highly rated by users</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:label"/>
            <Literal>isHighlyRatedRule</Literal>
        </Annotation>
        <Body>
            <ClassAtom>
                <Class IRI="#TourismResource"/>
                <Variable IRI="/t"/>
            </ClassAtom>
            <DataPropertyAtom>
                <DataProperty IRI="#hasRating"/>
                <Variable IRI="/t"/>
                <Variable IRI="/r"/>
            </DataPropertyAtom>
            <BuiltInAtom abbreviatedIRI="swrlb:greaterThanOrEqual">
                <Variable IRI="/r"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">4.5</Literal>
            </BuiltInAtom>
        </Body>
        <Head>
            <DataPropertyAtom>
                <DataProperty IRI="#isHighlyRatedByUsers"/>
                <Variable IRI="/t"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
            </DataPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="swrla:isRuleEnabled"/>
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal>Defines if a TourismResource isn&apos;t highly rated by users</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:label"/>
            <Literal>isntHighlyRatedRule</Literal>
        </Annotation>
        <Body>
            <ClassAtom>
                <Class IRI="#TourismResource"/>
                <Variable IRI="/t"/>
            </ClassAtom>
            <DataPropertyAtom>
                <DataProperty IRI="#hasRating"/>
                <Variable IRI="/t"/>
                <Variable IRI="/r"/>
            </DataPropertyAtom>
            <BuiltInAtom abbreviatedIRI="swrlb:lessThan">
                <Variable IRI="/r"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">4.5</Literal>
            </BuiltInAtom>
        </Body>
        <Head>
            <DataPropertyAtom>
                <DataProperty IRI="#isHighlyRatedByUsers"/>
                <Variable IRI="/t"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">false</Literal>
            </DataPropertyAtom>
        </Head>
    </DLSafeRule>
